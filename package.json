{
  "name": "@ownmode/connect",
  "version": "0.3.0",
  "description": "Connect apps and browsers to local models with explicit origin grants.",
  "homepage": "https://github.com/edwinjosechittilappilly/ownmode#readme",
  "repository": { "type": "git", "url": "https://github.com/edwinjosechittilappilly/ownmode.git" },
  "bugs": { "url": "https://github.com/edwinjosechittilappilly/ownmode/issues" },
  "keywords": ["local-ai", "ollama", "lm-studio", "browser", "inference"],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ownmode": "src/cli.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=70",
    "secrets": "secretlint '**/*'",
    "check": "npm run lint && npm run secrets && npm test",
    "build:apple": "mkdir -p bin && xcrun swiftc -parse-as-library -O apple/OwnModeApple.swift -o bin/ownmode-apple",
    "build:menubar": "sh menubar/build.sh",
    "smoke:ollama": "node scripts/smoke-ollama.js"
  },
  "files": [
    "src",
    "apple",
    "menubar",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs"
  ],
  "license": "Apache-2.0",
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "eslint": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "secretlint": "13.1.0"
  }
}
